{
  "name": "@velora/functions",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
