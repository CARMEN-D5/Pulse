    "shell": "firebase functions:shell",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@velora/shared": "file:../shared",
    "firebase-admin": "13.5.0",
    "firebase-functions": "6.4.0"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
