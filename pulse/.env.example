# Copy this file to `.env.local` in the same directory and fill in the values
# from Firebase Console → Project settings → General → Your apps → SDK setup.
# Create React App only exposes vars prefixed with REACT_APP_ to the bundle.
# Restart `npm start` after changing any of these.

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
