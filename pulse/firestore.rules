rules_version = '2';

// ============================================================================
// Pulse Firestore security rules
// ----------------------------------------------------------------------------
// Paste the contents of this file into Firebase Console →
//   Firestore Database → Rules → Publish.
//
// Covers all branches currently merged in:
//   login, finance-budget-tracker, to-do-list, scoring, entry-quiz,
//   social-media, plus teammates' physical-activity + missions collections.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // /users/{uid} — a user's profile document.
    //
    // Read is allowed for any signed-in user — the social-media feature
    // needs to look up other users by email and display their names on
    // posts and message threads. Write stays restricted to the owner so
    // nobody can edit someone else's profile.
    // ------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                            && request.auth.uid == uid;

      // On create, require that the doc's id matches the caller's uid and
      // the doc's `uid` field is consistent. This prevents a user from
      // creating documents on behalf of other users.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;

      // ----------------------------------------------------------------------
      // Finance — budgets, expenses, accounts. (finance-budget-tracker.)
      // ----------------------------------------------------------------------
      match /budgets/{category} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /accounts/{accountId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // To-do list. (to-do-list branch.)
      // ----------------------------------------------------------------------
      match /todos/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // Health — physical activity log. (teammate's branch.)
      // ----------------------------------------------------------------------
      match /physicalActivities/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // Scoring — reflections, actions, weekly score snapshots.
      // (scoring branch.)
      // ----------------------------------------------------------------------
      match /reflections/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /actions/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /weeklyScores/{weekId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // Missions. (teammate's branch.)
      //   /users/{uid}/missions/daily                    — current day doc
      //   /users/{uid}/missions/history/days/{dayKey}    — per-day history
      // ----------------------------------------------------------------------
      match /missions/daily {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /missions/history/days/{dayKey} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // ========================================================================
    // SOCIAL — daily posts, likes, comments. (social-media branch.)
    // ========================================================================
    //
    // Posts are public to every signed-in user. Only the author can edit or
    // delete their own post. Likes and comments are owner-write only.
    // ------------------------------------------------------------------------
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.authorUid;

      // /posts/{postId}/likes/{uid} — existence == liked.
      // The doc id IS the liker's uid so they can only ever like or unlike
      // on their own behalf.
      match /likes/{uid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                              && request.auth.uid == uid;
      }

      // /posts/{postId}/comments/{commentId}
      // Anyone signed in can read or comment; only the comment author may
      // edit or delete their own.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorUid;
        allow update, delete: if request.auth != null
                              && request.auth.uid == resource.data.authorUid;
      }
    }

    // ========================================================================
    // DMs — 1-on-1 conversations + messages. (social-media branch.)
    // ========================================================================
    //
    // Only the two participants of a conversation may read or write it.
    // Messages live in a sub-collection; the parent doc holds participants
    // and a last-message preview for the inbox list.
    // ------------------------------------------------------------------------
    match /conversations/{convId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        // Use the parent doc's participants list to authorise. `get()`
        // costs an extra read per check but keeps the rules safe and
        // simple at this scale.
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(convId))
                       .data.participants;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderUid
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(convId))
                         .data.participants;
      }
    }

    // ------------------------------------------------------------------------
    // Default deny — anything not explicitly matched above is blocked.
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
