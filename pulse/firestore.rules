rules_version = '2';

// ============================================================================
// Pulse Firestore security rules
// ----------------------------------------------------------------------------
// Paste the contents of this file into Firebase Console →
//   Firestore Database → Rules → Publish.
//
// Covers all branches currently merged in:
//   login, finance-budget-tracker, to-do-list, scoring, entry-quiz,
//   social-media (with friend-request layer), plus teammates'
//   physical-activity + missions collections.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper — does a friendship exist between uidA and uidB?
    //
    // Friendship docs are keyed by the sorted-and-joined uid pair, so we
    // check both possible orderings (rules don't have a sort function).
    // ------------------------------------------------------------------------
    function areFriends(uidA, uidB) {
      return exists(/databases/$(database)/documents/friendships/$(uidA + "_" + uidB))
          || exists(/databases/$(database)/documents/friendships/$(uidB + "_" + uidA));
    }

    // ------------------------------------------------------------------------
    // /users/{uid} — a user's profile document.
    //
    // Read is allowed for any signed-in user — the social-media feature
    // needs to look up other users by email and display their names on
    // posts and message threads. Write stays restricted to the owner so
    // nobody can edit someone else's profile.
    // ------------------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
                            && request.auth.uid == uid;

      // On create, require that the doc's id matches the caller's uid and
      // the doc's `uid` field is consistent. This prevents a user from
      // creating documents on behalf of other users.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;

      // ----------------------------------------------------------------------
      // Finance — budgets, expenses, accounts. (finance-budget-tracker.)
      // ----------------------------------------------------------------------
      match /budgets/{category} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /accounts/{accountId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // To-do list. (to-do-list branch.)
      // ----------------------------------------------------------------------
      match /todos/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // Health — physical activity log. (teammate's branch.)
      // ----------------------------------------------------------------------
      match /physicalActivities/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // Scoring — reflections, actions, weekly score snapshots.
      // (scoring branch.)
      // ----------------------------------------------------------------------
      match /reflections/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /actions/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /weeklyScores/{weekId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // Missions. (teammate's branch.)
      //   /users/{uid}/missions/daily                    — current day doc
      //   /users/{uid}/missions/history/days/{dayKey}    — per-day history
      // ----------------------------------------------------------------------
      match /missions/daily {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      match /missions/history/days/{dayKey} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // ========================================================================
    // FRIEND REQUESTS — pending requests, keyed by sorted-uid pair.
    // ========================================================================
    //
    // A request doc is created by the sender; the recipient can read it
    // (their inbox), accept it (which creates the friendship and deletes
    // the request), or decline it (just delete). Sender can also delete to
    // cancel an outgoing request.
    // ------------------------------------------------------------------------
    match /friendRequests/{requestId} {
      // Either party can read so they see incoming/outgoing requests live.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.from
                      || request.auth.uid == resource.data.to);

      // Only the sender can create; the `from` field must match their uid.
      // We also require `to != from` and that they aren't already friends.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.from
                    && request.resource.data.from != request.resource.data.to
                    && !areFriends(request.resource.data.from,
                                   request.resource.data.to);

      // Either party can delete (sender cancels, recipient declines,
      // or both delete after acceptance).
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.from
                        || request.auth.uid == resource.data.to);
    }

    // ========================================================================
    // FRIENDSHIPS — accepted friendships, keyed by sorted-uid pair.
    // ========================================================================
    //
    // Created by the accepter when they accept a friend request. Either
    // participant can read it (it's how the feed and DMs decide what to
    // show), and either may unfriend by deleting the doc.
    // ------------------------------------------------------------------------
    match /friendships/{friendshipId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      // On create, the writer must be one of the two participants, the
      // participants array must contain exactly two distinct uids, and
      // a matching friend request must exist (i.e. the relationship was
      // actually requested by one side and accepted by the other).
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && exists(/databases/$(database)/documents/friendRequests/$(friendshipId));

      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;
    }

    // ========================================================================
    // SOCIAL — daily posts, likes, comments. (social-media branch.)
    // ========================================================================
    //
    // Posts are friends-only: a signed-in user can read a post if they
    // are the author OR they have a friendship with the author. Only the
    // author can edit or delete their own post.
    // ------------------------------------------------------------------------
    match /posts/{postId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.authorUid
                      || areFriends(request.auth.uid, resource.data.authorUid));
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.authorUid;

      // /posts/{postId}/likes/{uid} — existence == liked.
      // The doc id IS the liker's uid so they can only ever like or unlike
      // on their own behalf. Like reads inherit the same friends-only
      // visibility as the parent post.
      match /likes/{uid} {
        allow read: if request.auth != null
                    && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                        || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
        allow create, delete: if request.auth != null
                              && request.auth.uid == uid
                              && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                                  || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
      }

      // /posts/{postId}/comments/{commentId}
      // Friends-only read; comment author may edit or delete their own.
      match /comments/{commentId} {
        allow read: if request.auth != null
                    && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                        || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorUid
                      && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                          || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
        allow update, delete: if request.auth != null
                              && request.auth.uid == resource.data.authorUid;
      }
    }

    // ========================================================================
    // DMs — 1-on-1 conversations + messages. (social-media branch.)
    // ========================================================================
    //
    // Conversation ids share the same sorted-uid-pair shape as friendship
    // ids, so a friendship is required to create a conversation. Only the
    // two participants of a conversation may read or write it.
    // ------------------------------------------------------------------------
    match /conversations/{convId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      // Create requires (a) caller is a participant, (b) exactly two
      // participants, (c) a friendship doc exists at the same id.
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && exists(/databases/$(database)/documents/friendships/$(convId));

      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        // Use the parent doc's participants list to authorise. `get()`
        // costs an extra read per check but keeps the rules safe and
        // simple at this scale.
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(convId))
                       .data.participants;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderUid
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(convId))
                         .data.participants;
      }
    }

    // ------------------------------------------------------------------------
    // Default deny — anything not explicitly matched above is blocked.
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
