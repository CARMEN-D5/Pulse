rules_version = '2';

// ============================================================================
// Pulse Firestore security rules
// ----------------------------------------------------------------------------
// Paste the contents of this file into Firebase Console →
//   Firestore Database → Rules → Publish.
//
// Covers the login + finance-budget-tracker + to-do-list branches.
// Extend as new collections (journals, missions, streaks, etc.) land
// in later sprints.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // /users/{uid} — a user's private profile document.
    // Only the signed-in user with the matching uid may read or write it.
    // ------------------------------------------------------------------------
    match /users/{uid} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == uid;

      // On create, require that the doc's id matches the caller's uid and
      // the doc's `uid` field is consistent. This prevents a user from
      // creating documents on behalf of other users.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;

      // ----------------------------------------------------------------------
      // /users/{uid}/budgets/{category}
      // Per-category monthly cap. Owner-only.
      // ----------------------------------------------------------------------
      match /budgets/{category} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // /users/{uid}/expenses/{expenseId}
      // Logged transactions. Owner-only.
      // ----------------------------------------------------------------------
      match /expenses/{expenseId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // /users/{uid}/todos/{docId}
      // To-do list items. Owner-only.
      // ----------------------------------------------------------------------
      match /todos/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }

      // ----------------------------------------------------------------------
      // /users/{uid}/accounts/{accountId}
      // Bank accounts / payment methods. Owner-only.
      // ----------------------------------------------------------------------
      match /accounts/{accountId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == uid;
      }
    }

    // ------------------------------------------------------------------------
    // Default deny — anything not explicitly matched above is blocked.
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
