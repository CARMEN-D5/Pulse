rules_version = '2';

// ============================================================================
// Pulse Firestore security rules
// ----------------------------------------------------------------------------
// Paste the contents of this file into Firebase Console →
//   Firestore Database → Rules → Publish.
//
// Covers all branches currently merged in:
//   login, finance-budget-tracker, to-do-list, scoring, entry-quiz,
//   social-media (with friend-request layer), plus teammates'
//   physical-activity + missions collections.
//
// Posts, likes, and comments are FRIENDS-ONLY at the rules level via the
// areFriends() helper. The helper checks both possible orderings of the
// sorted-uid friendship doc id, so it works no matter which of the two
// users initiated the friendship.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Helper — does a friendship exist between uidA and uidB?
    //
    // Friendship docs are keyed by the sorted-and-joined uid pair, so we
    // check both possible orderings (rules don't have a sort function).
    // ------------------------------------------------------------------------
    function areFriends(uidA, uidB) {
      return exists(/databases/$(database)/documents/friendships/$(uidA + "_" + uidB))
          || exists(/databases/$(database)/documents/friendships/$(uidB + "_" + uidA));
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid;

      match /budgets/{category}        { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /expenses/{expenseId}      { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /accounts/{accountId}      { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /todos/{docId}             { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /physicalActivities/{docId}{ allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /reflections/{docId}       { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /actions/{docId}           { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /weeklyScores/{weekId}     { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /missions/daily            { allow read, write: if request.auth != null && request.auth.uid == uid; }
      match /missions/history/days/{dayKey} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    }

    match /friendRequests/{requestId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.from
                      || request.auth.uid == resource.data.to);
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.from
                    && request.resource.data.from != request.resource.data.to
                    && !areFriends(request.resource.data.from, request.resource.data.to);
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.from
                        || request.auth.uid == resource.data.to);
    }

    match /friendships/{friendshipId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && exists(/databases/$(database)/documents/friendRequests/$(friendshipId));
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;
    }

    match /posts/{postId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.authorUid
                      || areFriends(request.auth.uid, resource.data.authorUid));
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorUid;
      allow update, delete: if request.auth != null
                            && request.auth.uid == resource.data.authorUid;

      match /likes/{uid} {
        allow read: if request.auth != null
                    && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                        || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
        allow create, delete: if request.auth != null
                              && request.auth.uid == uid
                              && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                                  || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
      }

      match /comments/{commentId} {
        allow read: if request.auth != null
                    && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                        || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.authorUid
                      && (request.auth.uid == get(/databases/$(database)/documents/posts/$(postId)).data.authorUid
                          || areFriends(request.auth.uid, get(/databases/$(database)/documents/posts/$(postId)).data.authorUid));
        allow update, delete: if request.auth != null
                              && request.auth.uid == resource.data.authorUid;
      }
    }

    match /conversations/{convId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && exists(/databases/$(database)/documents/friendships/$(convId));
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{msgId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderUid
                      && request.auth.uid in
                         get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
