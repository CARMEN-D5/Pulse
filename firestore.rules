rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /domains/{domainId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /actionRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /missions/{missionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if false;
      allow update: if isOwner(userId);
      allow delete: if false;

      match /domainBaselines/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /dailyCheckins/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /actionEvents/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /weeklyDomainSummaries/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /weeklyLifeSummaries/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /journalEntries/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /connectionLogs/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /userMissions/{docId} {
        allow read, create, update: if isOwner(userId);
        allow delete: if false;
      }

      match /tasks/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /focusSessions/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /activityLogs/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /sleepLogs/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /expenseLogs/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /financialActions/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }
  }
}
